# 前端环境变量示例(Vite:仅 VITE_ 前缀会暴露给客户端代码)
VITE_API_BASE_URL=/api

# 可选：无 Key 时可现场定位、粘贴坐标、高德/百度查看和导航。
# 浏览器 Key 需配置站点域名白名单；不要把服务端密钥放在 VITE_ 变量中。
VITE_AMAP_KEY=
VITE_BAIDU_MAP_AK=
VITE_TENCENT_MAP_KEY=
# 高德安全代理地址（必须以 /_AMapService 结尾），生产同源代理可留空。
VITE_AMAP_SERVICE_HOST=
# 仅供本机 Vite 开发代理读取（生产在 deploy/.env 配置）。不会打包到浏览器。
AMAP_SECURITY_JS_CODE=
