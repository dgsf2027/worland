# 沃朗租赁板块 生产环境变量模板 —— cp 为 .env 后填真值,chmod 600,**禁入 Git**
# ⚠️ 上线红线:rsync/部署到 prod 必须 exclude .env / .env.*(覆盖 prod .env = 全站 outage)

# ---- 数据库(编排自带 MySQL) ----
DB_PASSWORD=改成强密码
MYSQL_DATABASE=worland_prod

# ---- LLM 网关(留空=全 mock 不外呼;接真模型时填 OpenAI 兼容端点) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- SSO(占位头阶段=false;门户团队下发 app_id/client_secret 后接 ole-portal-sso 再置 true) ----
SSO_ENABLED=false
# SSO_PORTAL_BASE_URL=
# SSO_APP_ID=
# SSO_CLIENT_SECRET=

# ---- 对象存储签名密钥(占位期本地 HMAC;上线走 KMS) ----
FILE_SIGN_SECRET=改成随机长串
