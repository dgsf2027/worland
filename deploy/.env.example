# 沃朗租赁板块 生产环境变量模板 —— cp 为 .env 后填真值,chmod 600,**禁入 Git**
# ⚠️ 上线红线:rsync/部署到 prod 必须 exclude .env / .env.*(覆盖 prod .env = 全站 outage)

# ---- 数据库(编排自带 MySQL) ----
DB_PASSWORD=改成强密码
MYSQL_DATABASE=worland_prod

# ---- LLM 网关(OpenAI 兼容) ----
# 三项(base-url/api-key/model)全非空 → 真调用 POST {base-url}/v1/chat/completions;
# 任一留空 或 调用失败/超时/非200 → 回退 mock(零外呼·页面不空)。key 禁入 Git。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选:单次超时毫秒(默认 30000)/ 自签证书宽松容错(默认 true)
# LLM_TIMEOUT_MS=30000
# LLM_TRUST_ALL_SSL=true

# ---- 澳乐门户 SSO(eco.vvaix.com 生态管理平台点「曜石租赁」卡片免登直达 · ole-portal-sso 规范) ----
# false(默认)=SSO 模块不挂载,账号密码登录照旧;true 需下面四项齐全。全部占位,真值由运维填,禁入 Git。
SSO_ENABLED=false
# 门户 API 根(含 /api)。本机 Docker 部署时 portal-server 映射在宿主 18151,容器内走 host.docker.internal:
# SSO_PORTAL_BASE_URL=http://host.docker.internal:18151/api
SSO_PORTAL_BASE_URL=
# 门户管理后台(yc_portal_system)注册「曜石租赁」后分配;回调地址登记为 https://<本系统域名>/api/v1/sso/callback
SSO_APP_ID=
SSO_CLIENT_SECRET=
# JWT issuer 多值兼容(2026-04-25 门户改名 aole-portal,旧值仍认)
SSO_PORTAL_JWT_ISSUER=aole-portal,yunshan-portal
# 可选:只放行这些门户租户(逗号分隔),留空不限;可选:前端根地址(前后端不同域才填,同域反代留空)
# SSO_ALLOWED_TENANT_IDS=
# SSO_FRONTEND_BASE_URL=

# ---- 对象存储签名密钥(占位期本地 HMAC;上线走 KMS) ----
FILE_SIGN_SECRET=改成随机长串
